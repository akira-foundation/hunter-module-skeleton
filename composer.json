{
    "name": ":vendor_slug/hunter-:module_slug",
    "version": "1.0.0",
    "description": ":package_description",
    "keywords": [
        "Hunter",
        "laravel",
        ":module_slug"
    ],
    "homepage": "https://github.com/:vendor_slug/hunter-:module_slug",
    "license": "MIT",
    "authors": [
        {
            "name": ":author_name",
            "email": ":author_email",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "akira/hunter-module": "^1.0",
        "illuminate/contracts": "^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "akira/laravel-debugger": "^1.3",
        "akira/setup": "^1.3",
        "driftingly/rector-laravel": "^2.1",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "peckphp/peck": "^0.2.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.3",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            ":VendorNamespace:\\:StudlyModuleName:\\": "src/",
            ":VendorNamespace:\\:StudlyModuleName:\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            ":VendorNamespace:\\:StudlyModuleName:\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "hunter:install": [
            "@composer install --working-dir=dev",
            "@php dev/artisan hunter:install"
        ],
        "hunter:serve": "@php dev/artisan serve",
        "lint": [
            "@refactor",
            "pint"
        ],
        "refactor": "rector",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "test:arch": "pest --filter=arch",
        "test:types": "phpstan",
        "test:type-coverage": "pest --type-coverage --min=100 --compact",
        "test:coverage": "pest --parallel --coverage --compact --exactly=100",
        "test:typos": "peck",
        "test": [
            "@test:lint",
            "@test:refactor",
            "@test:typos",
            "@test:arch",
            "@test:types",
            "@test:coverage",
            "@test:type-coverage"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                ":VendorNamespace:\\:StudlyModuleName:\\:StudlyModuleName:ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
